{
  "expo": {
    "name": "Meridian",
    "slug": "meridian-bank",
    "scheme": "meridian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meridian.bankapp"
    },
    "android": {
      "package": "com.meridian.bankapp",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7293b2a1-c0f4-4a93-8b2e-befd45a78e9d"
      }
    },
    "owner": "stackhead02"
  }
}
